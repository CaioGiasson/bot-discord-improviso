// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Tenant {
  DISCORD
  TELEGRAM
  WHATSAPP
  WEB
}

model roll {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  tenant         Tenant
  playerName     String
  playerId       String
  rollCommand    String
  textoAdicional String?
  numeroRolagem  String?
  cdValue        String?
  resultMessage  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model player {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  tenant     Tenant
  playerName String
  discordId  String?
  telegramId String?
  whatsappId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
